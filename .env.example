# Copy to .env and fill in values. .env is gitignored — never commit it.
#
#   cp .env.example .env
#
# Load before running scripts:
#   set -a && source .env && set +a

OPENAI_API_KEY=sk-your-key-here
OPENAI_RESEARCH_MODEL=gpt-4.1
OPENAI_DAILY_SPEND_CAP_USD=2

# Google Places API — post-fetch restaurant verification (hard closure/rating/hours check)
# Enable "Places API (New)" on your Google Cloud project, then create an API key.
# GOOGLE_MAPS_API_KEY=AIza...

# Optional — only for local email dry-runs
# RESEND_API_KEY=re_...
# BRIEFING_FROM_EMAIL=News Briefing <onboarding@resend.dev>
# BRIEFING_TO_EMAIL=you@example.com
